@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix ex:  <http://example.org/> .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetNode ex:carol ;
    sh:property [
        sh:path ex:name ;
        sh:minCount 1 ;
        sh:message "Name is required"@en ;
        sh:message "Name ist erforderlich"@de ;
    ] .

ex:carol
    a ex:Person .
