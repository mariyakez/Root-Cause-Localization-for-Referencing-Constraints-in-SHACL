# Synthetic report. A property-level sh:node result that names the enclosing
# node shape in sh:sourceShape. Neither Apache Jena 6.2.0 nor TopBraid SHACL
# 1.5.0 emits this: both name the property shape instead (see
# sh_node_cases/*_real_tc7_property_no_detail.ttl). Kept as a robustness case.
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix ex:  <http://example.org/> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [
        a sh:ValidationResult ;
        sh:focusNode ex:bob ;
        sh:value ex:acme ;
        sh:resultPath ex:worksFor ;
        sh:sourceShape ex:PersonShape ;
        sh:sourceConstraintComponent sh:NodeConstraintComponent ;
        sh:resultMessage "Synthetic property sh:node result naming the enclosing node shape" ;
    ] .
