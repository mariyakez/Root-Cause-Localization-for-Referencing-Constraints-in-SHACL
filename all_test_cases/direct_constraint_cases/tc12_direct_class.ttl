@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix ex:  <http://example.org/> .

ex:EnrollmentShape
    a sh:NodeShape ;
    sh:targetNode ex:enrollment1 ;
    sh:property [
        sh:path ex:student ;
        sh:class ex:Student ;
        sh:message "The enrolled student must be an ex:Student" ;
    ] .

ex:enrollment1
    a ex:Enrollment ;
    ex:student ex:charlie .

ex:charlie
    a ex:Person .
