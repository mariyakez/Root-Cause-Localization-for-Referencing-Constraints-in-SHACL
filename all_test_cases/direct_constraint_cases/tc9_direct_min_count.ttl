@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix ex:  <http://example.org/> .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetNode ex:alice ;
    sh:property [
        sh:path ex:name ;
        sh:minCount 1 ;
        sh:message "A person must have a name" ;
    ] .

ex:alice
    a ex:Person .
