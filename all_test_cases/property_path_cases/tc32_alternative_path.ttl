@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix ex:  <http://example.org/> .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetNode ex:carol ;
    sh:property [
        sh:path [ sh:alternativePath (ex:email ex:phone) ] ;
        sh:minCount 1 ;
        sh:message "A person must have either email or phone" ;
    ] .

ex:carol
    a ex:Person .
