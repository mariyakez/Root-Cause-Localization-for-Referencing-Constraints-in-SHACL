@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .

# Synthetic report, the same structure as external_report_cases/TC43:
# the report identifies the enclosing node shape as sh:sourceShape and gives
# sh:resultPath/sh:value, but does not embed sh:detail or the anonymous
# property shape. Neither Apache Jena 6.2.0 nor TopBraid SHACL 1.5.0 emits this;
# both name the property shape instead (see *_real_tc7_property_no_detail.ttl).
# Kept as a robustness case. The explainer must recover:
#   ex:EmployeeShape sh:property [ sh:path ex:worksFor ; sh:node ex:CompanyShape ]
# from the original shapes graph.
[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [
        a sh:ValidationResult ;
        sh:focusNode ex:alice ;
        sh:value ex:acme ;
        sh:resultPath ex:worksFor ;
        sh:sourceConstraintComponent sh:NodeConstraintComponent ;
        sh:sourceShape ex:EmployeeShape ;
        sh:resultMessage "Value does not conform to shape ex:CompanyShape." ;
    ] .
