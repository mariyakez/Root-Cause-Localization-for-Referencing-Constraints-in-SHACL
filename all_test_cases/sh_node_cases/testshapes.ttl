@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix ex:  <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:PersonShape
    a sh:NodeShape ;
    sh:property [
        sh:path ex:age ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:message "ex:age is required and must be an integer" ;
    ] ;
    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "ex:name is required and must be a string" ;
    ] ;
    sh:property [
        sh:path ex:email ;
        sh:pattern "^\\S+@\\S+$" ;
        sh:message "ex:email must look like an email address" ;
    ] .

ex:EmployeeShape
    a sh:NodeShape ;
    sh:targetClass ex:Employee ;
    sh:node ex:PersonShape ;
    sh:property [
        sh:path ex:employeeId ;
        sh:minCount 1 ;
        sh:message "ex:employeeId is required for employees" ;
    ] .
