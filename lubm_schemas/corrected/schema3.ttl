        sh:minCount 1 ; 
    ];
    sh:property [
        sh:path ub:teacherOf ;
        sh:minCount 1 ; 
        sh:maxCount 2 ; 
        sh:node ub:CourseShape ;
    ];
    sh:property [
        sh:path ub:teacherOf ;
        sh:minCount 1 ; 
        sh:maxCount 2 ; 
        sh:node ub:GraduateCourseShape ;
    ];
    sh:property [
        sh:path ub:telephone ;
