        sh:minCount 1 ; 
        sh:node ub:DepartmentShape ;
    ]. 


ub:CourseShape
    a sh:NodeShape ;
    sh:targetClass ub:Course ;
    sh:property [
        sh:path ub:name ;
        sh:maxCount 1 ;
        sh:minCount 1 ; 
    ] .
    
ub:DepartmentShape
    a sh:NodeShape ;
    sh:targetClass ub:Department ;
    sh:property [
        sh:path ub:name ;
        sh:maxCount 1 ;
        sh:minCount 1 ; 
    ] ;
    sh:property [
        sh:path ub:subOrganizationOf ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node ub:UniversityShape ;
    ] .

