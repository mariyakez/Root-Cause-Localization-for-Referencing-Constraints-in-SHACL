        sh:maxCount 7 ;
        sh:minCount 1 ;
    ];
    #sh:not [
    #    sh:path ub:publicationAuthor ;
    #    sh:minCount 1 ;
    #    sh:node ub:UndergraduateStudentShape ;
    #] 
    .  

