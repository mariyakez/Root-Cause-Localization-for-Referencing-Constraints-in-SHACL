# Corrected copy of ../schema3.ttl for the LUBM evaluation, used alongside the
# supplied schema. Each correction repairs a defect reported by
# tools/audit_shacl_schema.py; the appendix gives the diff.
# 1. The property shapes on ub:type are removed, as in schema2.
# 2. sh:node ub:Course and sh:node ub:GraduateCourse become sh:node
#    ub:CourseShape and sh:node ub:GraduateCourseShape.
# 3. sh:manCount becomes sh:maxCount: a misspelling that validators ignore. A
#    sibling property shape on ub:teacherOf already caps it at 2, so this
#    repairs the written constraint without changing what the schema accepts.
# The requirement that a university carry an ub:name is deliberately left in
# place: the universities that fail it are ones the LUBM generator names
# without describing, which is a property of the data, not a schema defect.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ub: <http://swat.cse.lehigh.edu/onto/univ-bench.owl#>.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ub:AssistantProfessorShape
    a sh:NodeShape ;
    sh:targetClass ub:AssistantProfessor ;
    sh:property [
        sh:path ub:doctoralDegreeFrom ;
        sh:minCount 1 ; 
        sh:node ub:UniversityShape ;
    ];
    sh:property [
        sh:path ub:emailAddress ;
        sh:minCount 1 ; 
    ];
    sh:property [
        sh:path ub:mastersDegreeFrom ;
        sh:minCount 1 ; 
        sh:node ub:UniversityShape ;
    ];
    sh:property [
        sh:path ub:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ];
    sh:property [
        sh:path ub:researchInterest ;
        sh:minCount 1 ; 
    ];
    sh:property [
        sh:path ub:teacherOf ;
        sh:minCount 1 ; 
        sh:maxCount 2 ; 
        sh:node ub:CourseShape ;
    ];
    sh:property [
        sh:path ub:teacherOf ;
        sh:minCount 1 ; 
        sh:maxCount 2 ; 
        sh:node ub:GraduateCourseShape ;
    ];
    sh:property [
        sh:path ub:telephone ;
        sh:minCount 1 ; 
    ];
    sh:property [
        sh:path ub:undergraduateDegreeFrom ;
        sh:minCount 1 ; 
        sh:node ub:UniversityShape ;
    ];
    sh:property [
        sh:path ub:worksFor ;
        sh:minCount 1 ; 
        sh:node ub:DepartmentShape ;
    ].  

